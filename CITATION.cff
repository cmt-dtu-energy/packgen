    affiliation: Technical University of Denmark
  - given-names: Andreas
    family-names: Papanikolaou
    affiliation: Technical University of Denmark
version: 0.6.0
license: MIT
repository-code: "https://github.com/cmt-dtu-energy/packgen"
keywords:
  - particle packing
  - packing generator
  - blender
  - rigid-body simulation
